<?xml version="1.0"?>
<extension key="au.com.agileware.contactsummarymembershipreport" type="module">
  <file>contactsummarymembershipreport</file>
  <name>Contact Summary With Membership Type Report</name>
  <description>Extended Contact Summary report with support of filtering/showing custom fields of Individual contact along with Membership Type.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Agileware</author>
    <email>support@agileware.com.au</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://agileware.com.au</url>
    <url desc="Documentation">https://agileware.com.au</url>
    <url desc="Support">https://support.agileware.com.au</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-07-14</releaseDate>
  <version>1.1.0</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>5.82</ver>
  </compatibility>
  <civix>
    <namespace>CRM/Contactsummarymembershipreport</namespace>
    <format>25.10.2</format>
  </civix>
  <mixins>
    <mixin>mgd-php@2.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>smarty@1.0.3</mixin>
  </mixins>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
</extension>
